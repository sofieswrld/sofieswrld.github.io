---
import { render, type CollectionEntry } from "astro:content";
import { Link2 } from "@lucide/astro";
import { formatDate } from "../lib/content";
import YouTube from "./YouTube.astro";

interface Props {
  notes: CollectionEntry<"notes">[];
}

const { notes } = Astro.props;
const renderedNotes = await Promise.all(
  notes.map(async (note) => ({
    note,
    Content: (await render(note)).Content,
  })),
);

const getVisibleImages = (note: CollectionEntry<"notes">) =>
  note.data.images.slice(0, 4);

const getHiddenImages = (note: CollectionEntry<"notes">) =>
  note.data.images.slice(4);

const getHiddenImageCount = (note: CollectionEntry<"notes">) =>
  Math.max(note.data.images.length - 4, 0);
---

<ol class="timeline" data-note-timeline aria-label="조각글 타임라인">
  {
    renderedNotes.map(({ note, Content }) => (
      <li class="note" id={note.id} data-note-id={note.id}>
        <div class="note-heading">
          <h3>{note.data.title}</h3>
          <a
            class="anchor"
            href={`#${note.id}`}
            data-note-anchor
            aria-label={`${note.data.title} 링크 복사`}
          >
            <Link2 size={15} stroke-width={2.2} absoluteStrokeWidth />
            <span class="sr-only">링크 복사</span>
          </a>
        </div>
        <span class="meta">{formatDate(note.data.pubDate)}</span>
        <div class="prose">
          <Content />
        </div>
        {note.data.videos.length > 0 && (
          <div class="note-videos" aria-label={`${note.data.title} 영상`}>
            {note.data.videos.map((video) => (
              <YouTube id={video.id} title={video.title} />
            ))}
          </div>
        )}
        {note.data.images.length > 0 && (
          <div
            class:list={[
              "note-media-grid",
              `note-media-grid--${Math.min(note.data.images.length, 4)}`,
            ]}
            aria-label={`${note.data.title} 이미지`}
          >
            {getVisibleImages(note).map((image, index) => (
              <figure class="note-media">
                <a
                  class="note-media-link"
                  href={image.src}
                  data-pswp-width={image.width ?? 1200}
                  data-pswp-height={image.height ?? 800}
                  data-pswp-caption={image.alt}
                  aria-label={`${note.data.title} 이미지 크게 보기`}
                >
                  <img
                    src={image.src}
                    alt={image.alt}
                    loading="lazy"
                    decoding="async"
                    referrerpolicy="no-referrer"
                  />
                  {index === 3 && getHiddenImageCount(note) > 0 && (
                    <span class="note-media-more" aria-label={`이미지 ${getHiddenImageCount(note)}장 더 있음`}>
                      +{getHiddenImageCount(note)}
                    </span>
                  )}
                </a>
              </figure>
            ))}
            {getHiddenImages(note).map((image) => (
              <a
                class="note-media-hidden"
                href={image.src}
                data-pswp-width={image.width ?? 1200}
                data-pswp-height={image.height ?? 800}
                data-pswp-caption={image.alt}
                aria-hidden="true"
                tabindex="-1"
              >
                {image.alt}
              </a>
            ))}
          </div>
        )}
      </li>
    ))
  }
</ol>
<p class="copy-toast" data-copy-toast role="status" aria-live="polite">Copied!</p>

<script>
  import "../scripts/note-timeline";
</script>
